# TPSS automated tests — settings template. PLACEHOLDERS ONLY.
#
# 1. Copy this file to  tests/.env.test.local  (that name is gitignored and never committed).
# 2. Fill in the values on your own computer. Never paste passwords into chat, email or tickets.
#
# Sandbox database (public values — the same ones the sandbox website uses).
TEST_SUPABASE_URL=https://femkwbgjvsdnxnihptiu.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=<sandbox publishable/anon key>

# Where browser tests open the app. Default: a private local dev server on port 8090.
TEST_APP_BASE_URL=http://localhost:8090

# Dedicated SANDBOX test accounts (synthetic, one per role). Leave blank until created;
# tests that need an account skip with a clear reason.
TEST_SUPER_ADMIN_EMAIL=
TEST_SUPER_ADMIN_PASSWORD=
TEST_CEO_ADMIN_EMAIL=
TEST_CEO_ADMIN_PASSWORD=
TEST_COO_OPS_EMAIL=
TEST_COO_OPS_PASSWORD=
TEST_ACCOUNTANT_EMAIL=
TEST_ACCOUNTANT_PASSWORD=
# A deactivated account, used to prove deactivated users are refused.
TEST_INACTIVE_EMAIL=
TEST_INACTIVE_PASSWORD=
